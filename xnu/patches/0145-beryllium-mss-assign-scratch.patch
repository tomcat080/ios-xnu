+
+/* ---------------------------------------------------------------- stage 6: assign a page we own */
+
+/*
+ * Stage 5 (sweetwlan=5) never came back from the ASSIGN SMC when the target
+ * was the MBA carve-out at 0x96900000 with the Q6 still in reset: the call
+ * printed its arguments and then the EL3 side never returned, while the rest
+ * of the kernel booted normally. This stage keeps everything identical except
+ * the region under test: one page of kernel-owned scratch memory, no carve-out,
+ * no XPU owner conflict. It answers "does ASSIGN work at all on this phone",
+ * which decides whether stage 5 hung on the region or on the call itself.
+ *
+ * The page is page-aligned and page-sized, so it is nobody else's memory. If
+ * the reverse call fails, the page stays with MSS_MSA and is never touched
+ * again (no read, no free), so a stale owner cannot fault the kernel later.
+ */
+
+static uint8_t mss_scratch_page[4096] __attribute__((aligned(4096)));
+
+static void
+wl_mss_assign_scratch(void)
+{
+	volatile uint32_t *w = (volatile uint32_t *)(void *)mss_scratch_page;
+	ppnum_t pn;
+	uint64_t pa;
+	int fwd, back;
+
+	printf("SWEET MSS: stage 6 scratch-page assign test (no carve-out)\n");
+	pn = pmap_find_phys(kernel_pmap, (addr64_t)mss_scratch_page);
+	if (!pn) {
+		printf("SWEET MSS: scratch page has no physical page\n");
+		return;
+	}
+	pa = (uint64_t)pn * 4096u;
+
+	*w = 0x5a5a5a5au;
+	__asm__ volatile ("dmb sy" ::: "memory");
+	printf("SWEET MSS: scratch va %#llx pa %#llx readable, word0 %08x\n",
+	    (unsigned long long)(uintptr_t)mss_scratch_page, pa, *w);
+
+	fwd = mss_assign(pa, PAGE_SIZE, MSS_VMID_HLOS, MSS_VMID_MSS_MSA, MSS_PERM_RW);
+	if (fwd != 0) {
+		printf("SWEET MSS: scratch forward assign failed (%d); reverse not attempted\n", fwd);
+		return;
+	}
+
+	back = mss_assign(pa, PAGE_SIZE, MSS_VMID_MSS_MSA, MSS_VMID_HLOS, MSS_PERM_RWX);
+	if (back != 0) {
+		printf("SWEET MSS: scratch reverse assign failed (%d); page left with MSS, never touched\n", back);
+		return;
+	}
+
+	__asm__ volatile ("dsb sy" ::: "memory");
+	printf("SWEET MSS: scratch readable after round trip: %08x\n", *w);
+	printf("SWEET MSS: stage 6 done (TZ ASSIGN works; stage 5 hang is region-specific)\n");
+}
+
 /* ---------------------------------------------------------------- thread */
 
 static void
@@ -3049,6 +3116,8 @@ wl_thread(void *arg, wait_result_t wr)
 		wl_mss_preflight();
 	} else if (wl.stage == 5) {
 		wl_mss_assign_test();
+	} else if (wl.stage == 6) {
+		wl_mss_assign_scratch();
 	}
 out:
 	(void)thread_terminate(current_thread());
