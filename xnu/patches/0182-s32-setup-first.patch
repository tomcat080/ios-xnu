+static uint32_t s30_word(const uint8_t *p, uint32_t n);
+
+/* ---------------------------------------------------------------- stage 32: supported + mem_setup before init */
+
+static void
+wl_audio_stage32(void)
+{
+	static struct wl_fat fat;
+	static uint8_t mdt[8192];
+	struct mss_scm_regs r;
+	uint32_t cl = 0, size = 0, i;
+	int32_t rc;
+	volatile uint32_t *cv;
 
+	printf("SWEET AUDIO: stage 32 start\n");
+	rc = sweet_rpmh_arc_set("cx.lvl", 384u);
+	printf("SWEET AUDIO: S32 cx.lvl -> %d\n", rc);
+	rc = aud_pas_call(AUD_CMD_PAS_SUPPORTED, AUD_ARGINFO_AUTH, AUD_PAS_ID, 0, 0,
+	    "S32 PAS_IS_SUPPORTED", &r);
+	printf("SWEET AUDIO: S32 supported rc=%d\n", rc);
+	if (fat_mount(&fat, "modem")) {
+		printf("SWEET AUDIO: S32 fat mount failed\n");
+		return;
+	}
+	if (fat_open(&fat, "image/adsp.mdt", &cl, &size) || size > sizeof(mdt)
+	    || fat_read_chain(&fat, cl, 0, mdt, size)) {
+		printf("SWEET AUDIO: S32 mdt read failed\n");
+		return;
+	}
+	cv = (volatile uint32_t *)ml_io_map(AUD_ADSP_PA, AUD_META_PAGE);
+	printf("SWEET AUDIO: S32 carve=%#llx head=%08x\n", (unsigned long long)cv,
+	    cv ? cv[0] : 0);
+	if (!cv || size > AUD_META_PAGE) {
+		return;
+	}
+	for (i = 0; i < (size + 3u) / 4u; i++) {
+		cv[i] = s30_word(mdt + i * 4u, size - i * 4u);
+	}
+	printf("SWEET AUDIO: S32 mdt only written, head=%08x size=%u\n", cv[0], size);
+	rc = aud_pas_call(AUD_CMD_PAS_SETUP, AUD_ARGINFO_SETUP, AUD_PAS_ID,
+	    AUD_ADSP_PA, AUD_ADSP_SIZE, "S32 PAS_MEM_SETUP", &r);
+	printf("SWEET AUDIO: S32 SETUP rc=%d\n", rc);
+	rc = aud_pas_call(AUD_CMD_PAS_INIT, AUD_ARGINFO_INIT, AUD_PAS_ID, AUD_ADSP_PA, size,
+	    "S32 PAS_INIT(carve)", &r);
+	printf("SWEET AUDIO: S32 INIT rc=%d\n", rc);
+	printf("SWEET AUDIO: S32 done\n");
+}
