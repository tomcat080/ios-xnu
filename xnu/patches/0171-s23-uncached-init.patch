--- a/bsd/dev/beryllium_wlan.c
+++ b/bsd/dev/beryllium_wlan.c
@@ -3999,6 +3999,94 @@
 		printf("SWEET AUDIO: S21 init id=%u rc=%d\n", id, rc);
 	}
 	printf("SWEET AUDIO: S21 done\n");
+}
+
+/* ---------------------------------------------------------------- stage 23: uncached metadata + INIT */
+
+static void
+wl_audio_stage23(void)
+{
+	static struct wl_fat fat;
+	static uint8_t mdt[8192];
+	struct elf32_ehdr eh;
+	struct elf32_phdr ph;
+	struct mss_scm_regs r;
+	vm_offset_t meta_cached;
+	uint64_t pa;
+	uint32_t cl = 0, size = 0, hcl = 0, hsz = 0, i, len = 0;
+	int32_t rc;
+	ppnum_t pn;
+	volatile uint32_t *g, *cv;
+	volatile uint8_t *mc;
+
+	printf("SWEET AUDIO: stage 23 start\n");
+	g = (volatile uint32_t *)ml_io_map(WL_GCC_PA, WL_GCC_SIZE);
+	printf("SWEET AUDIO: S23 lpass q6_axi=%#x sway=%#x (read-only)\n",
+	    g ? g[0x47000 / 4] : 0, g ? g[0x47008 / 4] : 0);
+	cv = (volatile uint32_t *)ml_io_map(AUD_ADSP_PA, 0x1000);
+	printf("SWEET AUDIO: S23 carve head=%08x %08x\n", cv ? cv[0] : 0, cv ? cv[1] : 0);
+
+	if (fat_mount(&fat, "modem")) {
+		printf("SWEET AUDIO: S23 fat mount failed\n");
+		return;
+	}
+	if (fat_open(&fat, "image/adsp.mdt", &cl, &size) || size > sizeof(mdt)
+	    || fat_read_chain(&fat, cl, 0, mdt, size)) {
+		printf("SWEET AUDIO: S23 mdt read failed\n");
+		return;
+	}
+	memcpy(&eh, mdt, sizeof(eh));
+	for (i = 0; i < eh.e_phnum; i++) {
+		memcpy(&ph, mdt + eh.e_phoff + (uint64_t)i * sizeof(ph), sizeof(ph));
+		if ((ph.p_flags & MDT_TYPE_MASK) == MDT_TYPE_HASH) {
+			if (fat_open(&fat, "image/adsp.b01", &hcl, &hsz) || hsz != ph.p_filesz) {
+				printf("SWEET AUDIO: S23 hash read failed\n");
+				return;
+			}
+			break;
+		}
+	}
+	len = size;
+	if (kmem_alloc_contig(kernel_map, &meta_cached, AUD_META_PAGE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SWEET AUDIO: S23 alloc failed\n");
+		return;
+	}
+	pn = pmap_find_phys(kernel_pmap, (addr64_t)meta_cached);
+	if (!pn) {
+		printf("SWEET AUDIO: S23 pa lookup failed\n");
+		return;
+	}
+	pa = (uint64_t)pn * 4096u;
+	mc = (volatile uint8_t *)ml_io_map(pa, AUD_META_PAGE);
+	printf("SWEET AUDIO: S23 uncached meta va=%#llx pa=%#llx\n", (unsigned long long)mc,
+	    (unsigned long long)pa);
+	if (!mc) {
+		return;
+	}
+	for (i = 0; i < size; i++) {
+		mc[i] = mdt[i];
+	}
+	for (i = 0; i < eh.e_phnum; i++) {
+		memcpy(&ph, mdt + eh.e_phoff + (uint64_t)i * sizeof(ph), sizeof(ph));
+		if ((ph.p_flags & MDT_TYPE_MASK) == MDT_TYPE_HASH) {
+			if (fat_read_chain(&fat, hcl, 0, mdt, hsz)) {
+				printf("SWEET AUDIO: S23 hash read failed\n");
+				return;
+			}
+			for (i = 0; i < hsz; i++) {
+				mc[size + i] = mdt[i];
+			}
+			len += hsz;
+			break;
+		}
+	}
+	printf("SWEET AUDIO: S23 meta len=%u head=%08x tail=%08x\n", len, mc[0] | (mc[1] << 8) | (mc[2] << 16) | (mc[3] << 24),
+	    mc[len - 1]);
+	rc = aud_pas_call(AUD_CMD_PAS_INIT, AUD_ARGINFO_INIT, AUD_PAS_ID, pa, len,
+	    "S23 PAS_INIT(uncached)", &r);
+	printf("SWEET AUDIO: S23 INIT rc=%d\n", rc);
+	printf("SWEET AUDIO: S23 done\n");
 }
 
 /* ---------------------------------------------------------------- stage 22: LPASS clocks + carve probe + INIT retry */
@@ -4647,7 +4735,7 @@
 		}
 	}
 	wl_sleep(wl.delay_s * 1000u);
-	if (wl.stage < 19 || wl.stage > 22) {
+	if (wl.stage < 19 || wl.stage > 23) {
 		if (!wl_map()) {
 			printf("SWEET WLAN: MMIO mapping failed\n");
 			goto out;
@@ -4696,6 +4784,8 @@
 		wl_audio_stage21();
 	} else if (wl.stage == 22) {
 		wl_audio_stage22();
+	} else if (wl.stage == 23) {
+		wl_audio_stage23();
 	}
 out:
 	(void)thread_terminate(current_thread());
