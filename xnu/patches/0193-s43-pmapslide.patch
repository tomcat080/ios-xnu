 #define AUD_PT_LOAD 1u
 #define AUD_WIN 0x10000u
+
+#define AUD_MAP_WIN 0x200000u
+
+static int
+aud_win_slide(volatile uint8_t *cb, uint64_t new_base)
+{
+	uint32_t k;
+
+	printf("SWEET AUDIO: S43 slide win -> %#llx\n", (unsigned long long)new_base);
+	for (k = 0; k < AUD_MAP_WIN; k += 0x1000) {
+		pmap_enter(kernel_pmap, (vm_map_address_t)(cb + k), new_base + k,
+		    VM_PROT_READ | VM_PROT_WRITE, VM_WIMG_IO, TRUE);
+	}
+	__asm__ volatile ("dmb sy" ::: "memory");
+	if (pmap_find_phys(kernel_pmap, (addr64_t)cb) != (ppnum_t)(new_base >> 12)) {
+		printf("SWEET AUDIO: S43 slide verify failed phys=%#x want=%#x\n",
+		    pmap_find_phys(kernel_pmap, (addr64_t)cb),
+		    (unsigned)(new_base >> 12));
+		return -1;
+	}
+	return 0;
+}
 
