+/* ---------------------------------------------------------------- stage 15: PAS INIT argument probing */
+
+static void
+wl_audio_stage15(void)
+{
+	static struct wl_fat fat;
+	struct mss_scm_regs r;
+	uint32_t len, id, i;
+	static const uint32_t arginfo[3] = {
+		0x43,   /* QCOM_SCM_ARGS(3, VAL, RO, VAL): downstream msm-4.9 form */
+		0x83,   /* QCOM_SCM_ARGS(3, VAL, RW, VAL) */
+		0x82,   /* QCOM_SCM_ARGS(2, VAL, RW): upstream form, already failed */
+	};
+
+	printf("SWEET AUDIO: stage 15 start: probe PAS_INIT_IMAGE arginfo/pas_id\n");
+	if (fat_mount(&fat, "modem")) {
+		printf("SWEET AUDIO: modem FAT mount failed\n");
+		return;
+	}
+	len = aud_meta_build(&fat);
+	if (!len) {
+		printf("SWEET AUDIO: metadata build failed\n");
+		return;
+	}
+	for (i = 0; i < 3; i++) {
+		printf("SWEET AUDIO: try arginfo %#x pas_id 1 len %u\n", arginfo[i], len);
+		if (!aud_pas_call(AUD_CMD_PAS_INIT, arginfo[i], AUD_PAS_ID, aud_meta_pa, len,
+		    "PAS_INIT_IMAGE", &r)) {
+			printf("SWEET AUDIO: INIT ok with arginfo %#x\n", arginfo[i]);
+			return;
+		}
+	}
+	for (id = 2; id <= 5; id++) {
+		printf("SWEET AUDIO: try pas_id %u with arginfo %#x\n", id, arginfo[0]);
+		if (!aud_pas_call(AUD_CMD_PAS_INIT, arginfo[0], id, aud_meta_pa, len,
+		    "PAS_INIT_IMAGE", &r)) {
+			printf("SWEET AUDIO: INIT ok with pas_id %u\n", id);
+			return;
+		}
+	}
+	printf("SWEET AUDIO: all INIT probes rejected\n");
+}
