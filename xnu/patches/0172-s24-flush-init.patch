 		if (!wl_map()) {
 			printf("SWEET WLAN: MMIO mapping failed\n");
 			goto out;
@@ -4786,6 +4860,8 @@
 		wl_audio_stage22();
 	} else if (wl.stage == 23) {
 		wl_audio_stage23();
+	} else if (wl.stage == 24) {
+		wl_audio_stage24();
 	}
 out:
 	(void)thread_terminate(current_thread());
