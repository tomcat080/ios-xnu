diff --git a/bsd/dev/beryllium_wlan.c b/bsd/dev/beryllium_wlan.c
index 35950ab..48dcf77 100644
--- a/bsd/dev/beryllium_wlan.c
+++ b/bsd/dev/beryllium_wlan.c
@@ -3639,6 +3639,140 @@ wl_audio_stage18(void)
 	printf("SWEET AUDIO: stage 18 done (no segment write, no AUTH)\n");
 }
 
+/* ---------------------------------------------------------------- stage 19: early work, late report */
+
+/*
+ * iOS starts hammering UFS well before our +150/+300 s windows; the raw UFS
+ * reader then wedges inside fat_mount and every later print is lost.  Stage 19
+ * runs the whole PAS experiment at the stage-15-proven +90 s point, records a
+ * step bitmask, and a second kernel thread reports it at +330 s (after the
+ * UDP console is up, with no UFS traffic of its own).
+ */
+#define S19_FAT         (1u << 0)
+#define S19_MDT         (1u << 1)
+#define S19_HASH        (1u << 2)
+#define S19_ALLOC       (1u << 3)
+#define S19_ALIAS       (1u << 4)
+#define S19_WRITE       (1u << 5)
+#define S19_READBACK    (1u << 6)
+#define S19_INITCALL    (1u << 7)
+#define S19_SETUPCALL   (1u << 8)
+#define S19_FAIL        (1u << 16)
+
+static volatile uint32_t s19_steps;
+static volatile uint32_t s19_len, s19_head, s19_tail;
+static volatile int32_t s19_init = -777, s19_setup = -777;
+
+static void
+s19_report(void *arg, wait_result_t wr)
+{
+	(void)arg;
+	(void)wr;
+	wl_sleep((wl.delay_s + 240u) * 1000u);
+	printf("SWEET AUDIO: S19 report steps=%#x len=%u head=%08x tail=%08x init=%d setup=%d\n",
+	    s19_steps, s19_len, s19_head, s19_tail, s19_init, s19_setup);
+	thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+wl_audio_stage19(void)
+{
+	static struct wl_fat fat;
+	static uint8_t mdt[8192];
+	struct elf32_ehdr eh;
+	struct elf32_phdr ph;
+	struct mss_scm_regs r;
+	vm_offset_t meta_cached, meta_unc;
+	uint64_t pa;
+	uint32_t cl = 0, size = 0, hcl = 0, hsz = 0, i, len = 0;
+	int err;
+	ppnum_t pn;
+	volatile uint32_t *w;
+
+	printf("SWEET AUDIO: stage 19 start\n");
+	if (fat_mount(&fat, "modem")) {
+		s19_steps |= S19_FAIL;
+		return;
+	}
+	s19_steps |= S19_FAT;
+
+	err = fat_open(&fat, "image/adsp.mdt", &cl, &size);
+	if (err || size > sizeof(mdt) || fat_read_chain(&fat, cl, 0, mdt, size)) {
+		s19_steps |= S19_FAIL;
+		return;
+	}
+	memcpy(&eh, mdt, sizeof(eh));
+	s19_steps |= S19_MDT;
+
+	for (i = 0; i < eh.e_phnum; i++) {
+		memcpy(&ph, mdt + eh.e_phoff + (uint64_t)i * sizeof(ph), sizeof(ph));
+		if ((ph.p_flags & MDT_TYPE_MASK) != MDT_TYPE_HASH) {
+			continue;
+		}
+		if (fat_open(&fat, "image/adsp.b01", &hcl, &hsz) || hsz != ph.p_filesz
+		    || size + hsz > AUD_META_PAGE) {
+			s19_steps |= S19_FAIL;
+			return;
+		}
+		s19_steps |= S19_HASH;
+		break;
+	}
+	len = size;
+
+	if (kmem_alloc_contig(kernel_map, &meta_cached, AUD_META_PAGE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		s19_steps |= S19_FAIL;
+		return;
+	}
+	s19_steps |= S19_ALLOC;
+	pn = pmap_find_phys(kernel_pmap, (addr64_t)meta_cached);
+	if (!pn) {
+		s19_steps |= S19_FAIL;
+		return;
+	}
+	pa = (uint64_t)pn * 4096u;
+	sweet_dma_sync_va((const void *)meta_cached, AUD_META_PAGE);
+
+	meta_unc = ml_io_map(pa, AUD_META_PAGE);
+	if (meta_unc == 0) {
+		s19_steps |= S19_FAIL;
+		return;
+	}
+	s19_steps |= S19_ALIAS;
+
+	memcpy((void *)meta_unc, mdt, size);
+	for (i = 0; i < eh.e_phnum; i++) {
+		memcpy(&ph, mdt + eh.e_phoff + (uint64_t)i * sizeof(ph), sizeof(ph));
+		if ((ph.p_flags & MDT_TYPE_MASK) != MDT_TYPE_HASH) {
+			continue;
+		}
+		if (fat_read_chain(&fat, hcl, 0, (uint8_t *)meta_unc + size, hsz)) {
+			s19_steps |= S19_FAIL;
+			return;
+		}
+		len += hsz;
+		break;
+	}
+	s19_steps |= S19_WRITE;
+
+	w = (volatile uint32_t *)meta_unc;
+	s19_len = len;
+	s19_head = w[0];
+	s19_tail = w[(len / 4u) - 1u];
+	s19_steps |= S19_READBACK;
+
+	s19_steps |= S19_INITCALL;
+	s19_init = aud_pas_call(AUD_CMD_PAS_INIT, AUD_ARGINFO_INIT, AUD_PAS_ID, pa, len,
+	    "PAS_INIT_IMAGE(S19)", &r);
+	if (s19_init) {
+		return;
+	}
+	s19_steps |= S19_SETUPCALL;
+	s19_setup = aud_pas_call(AUD_CMD_PAS_SETUP, AUD_ARGINFO_SETUP, AUD_PAS_ID, AUD_ADSP_PA,
+	    AUD_ADSP_SIZE, "PAS_MEM_SETUP(S19)", &r);
+}
+
 /* ---------------------------------------------------------------- stage 13: ADSP segment load */
 
 static uint32_t
@@ -4177,6 +4311,14 @@ wl_thread(void *arg, wait_result_t wr)
 	(void)arg;
 	(void)wr;
 	printf("SWEET WLAN: stage %u starts in %u s\n", wl.stage, wl.delay_s);
+	if (wl.stage == 19) {
+		thread_t rt;
+		if (kernel_thread_start(s19_report, NULL, &rt) == KERN_SUCCESS) {
+			thread_deallocate(rt);
+		} else {
+			printf("SWEET WLAN: S19 reporter thread failed\n");
+		}
+	}
 	wl_sleep(wl.delay_s * 1000u);
 	if (!wl_map()) {
 		printf("SWEET WLAN: MMIO mapping failed\n");
@@ -4217,6 +4359,8 @@ wl_thread(void *arg, wait_result_t wr)
 		wl_audio_stage17();
 	} else if (wl.stage == 18) {
 		wl_audio_stage18();
+	} else if (wl.stage == 19) {
+		wl_audio_stage19();
 	}
 out:
 	(void)thread_terminate(current_thread());
